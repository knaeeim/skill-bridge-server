// ===== BOOKING & REVIEW MODELS =====
model Booking {
  id        String @id @default(uuid())
  studentId String
  tutorId   String

  student User @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User @relation("TutorBookings", fields: [tutorId], references: [id], onDelete: Cascade)

  subject Subjects

  date      DateTime
  startTime String
  endTime   String
  price     Int

  status BookingStatus @default(CONFIRMED)
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, tutorId, date, startTime])
}

model Review {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  studentId String
  tutorId   String

  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
}
